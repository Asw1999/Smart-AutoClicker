<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/menu_background"
        style="@style/AppTheme.Overlay.FloatingMenu.CardView"
        tools:viewBindingIgnore="true">

        <LinearLayout
            android:id="@+id/menu_items"
            style="@style/AppTheme.Overlay.FloatingMenu.LayoutButtons"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Red recording status dot -->
            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/recording_dot" />

            <!-- Point counter text -->
            <TextView
                android:id="@+id/text_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="0 pts"
                android:textColor="@color/overlayMenuButtons"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Pause / Resume button -->
            <ImageButton
                android:id="@+id/btn_pause_resume"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:src="@drawable/ic_pause"
                android:contentDescription="Pause or resume recording" />

            <!-- Stop button (Save recording) -->
            <ImageButton
                android:id="@+id/btn_stop"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:src="@drawable/ic_stop"
                android:contentDescription="Stop and save recording" />

            <!-- Cancel button (Discard recording) -->
            <ImageButton
                android:id="@+id/btn_cancel"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:src="@drawable/ic_cancel"
                android:contentDescription="Cancel recording" />

            <!-- Drag & Move handle -->
            <ImageButton
                android:id="@+id/btn_move"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:src="@drawable/ic_move"
                android:contentDescription="@string/content_desc_move_menu" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</FrameLayout>
